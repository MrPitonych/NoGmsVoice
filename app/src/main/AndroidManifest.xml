<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 11 checks the calling app's microphone permission through the recognizer, so the recognizer
         has to be able to see that app, and the caller can be any app on the TV. Without this every caller
         gets ERROR_INSUFFICIENT_PERMISSIONS. The lint rule is Google Play policy; this app is not on Play. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- No activity, so no icon to show; backups are off and there is nothing worth extracting. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        tools:ignore="DataExtractionRules,MissingApplicationIcon">

        <!-- A system recognizer is reachable by every app: that is the point of it. -->
        <service
            android:name=".VoskRecognitionService"
            android:exported="true"
            android:label="@string/service_label"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- adb shell am broadcast -n io.github.mrpitonych.nogmsvoice/.WarmupReceiver
             DUMP is held by adb's shell and granted to no installed app, so only ADB can send it. -->
        <receiver
            android:name=".WarmupReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
