# Copy to keystore.properties (ignored by git) to sign release builds with your own key.
# Create the key once. The certificate's name is public in every APK and cannot change without a new key:
#   keytool -genkeypair -keystore /home/you/.android/nogmsvoice-release.jks -alias nogmsvoice -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=YourName"
# storeFile is absolute, or relative to the repository root; on Windows use forward slashes (C:/Users/...).
# keytool's PKCS12 keystores use one password for the store and the key, so keyPassword = storePassword.
storeFile=/home/you/.android/nogmsvoice-release.jks
storePassword=...
keyAlias=nogmsvoice
keyPassword=...
